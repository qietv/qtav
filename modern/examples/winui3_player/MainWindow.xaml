<Window
    x:Class="QtAVWinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:QtAVWinUI3"
    Closed="Window_Closed">
    <Grid
        Padding="12"
        RowSpacing="10"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="OpenFileButton"
                Click="OpenFile_Click"
                Content="打开文件"
                VerticalAlignment="Bottom" />

            <TextBox
                x:Name="UrlTextBox"
                Grid.Column="1"
                Header="媒体 URL"
                KeyDown="UrlTextBox_KeyDown"
                PlaceholderText="https://example.com/video.mp4" />

            <Button
                x:Name="OpenUrlButton"
                Grid.Column="2"
                Click="OpenUrl_Click"
                Content="播放 URL"
                VerticalAlignment="Bottom" />

            <ToggleButton
                x:Name="DebugToggle"
                Grid.Column="3"
                Checked="DebugToggle_Checked"
                Content="Debug"
                Unchecked="DebugToggle_Unchecked"
                VerticalAlignment="Bottom" />
        </Grid>

        <Border
            Grid.Row="1"
            Background="Black"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <SwapChainPanel
                    x:Name="VideoPanel"
                    Loaded="VideoPanel_Loaded" />

                <Border
                    Margin="12"
                    Padding="8,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#B0202020"
                    CornerRadius="4">
                    <TextBlock
                        x:Name="StatusText"
                        Foreground="White"
                        Text="就绪" />
                </Border>
            </Grid>
        </Border>

        <Grid
            Grid.Row="2"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="CurrentTimeText"
                MinWidth="64"
                Text="00:00"
                VerticalAlignment="Center" />

            <Slider
                x:Name="ProgressSlider"
                Grid.Column="1"
                IsEnabled="False"
                Maximum="1"
                Minimum="0"
                ValueChanged="ProgressSlider_ValueChanged"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="DurationText"
                Grid.Column="2"
                MinWidth="64"
                Text="--:--"
                TextAlignment="Right"
                VerticalAlignment="Center" />
        </Grid>

        <Grid
            Grid.Row="3"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PlayPauseButton"
                Click="PlayPause_Click"
                Content="播放"
                MinWidth="88" />

            <Button
                Grid.Column="1"
                Click="Stop_Click"
                Content="停止"
                MinWidth="72" />

            <TextBlock
                x:Name="MediaNameText"
                Grid.Column="2"
                Margin="8,0,0,0"
                Opacity="0.72"
                Text="尚未打开媒体"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
