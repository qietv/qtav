+#if CONFIG_HEVC_MEDIACODEC_DECODER
+static int64_t mediacodec_presentation_time_us(AVCodecContext *avctx,
+                                               int64_t pts)
+{
+    if (pts == AV_NOPTS_VALUE)
+        return 0;
+    if (pts && avctx->pkt_timebase.num && avctx->pkt_timebase.den)
+        return av_rescale_q(pts, avctx->pkt_timebase, AV_TIME_BASE_Q);
+    return pts;
+}
+
+static void mediacodec_dovi_queue_pop(MediaCodecH264DecContext *s,
+                                      MediaCodecDOVIMetadata *previous,
+                                      MediaCodecDOVIMetadata *entry)
+{
+    if (previous)
+        previous->next = entry->next;
+    else
+        s->dovi_head = entry->next;
+    if (s->dovi_tail == entry)
+        s->dovi_tail = previous;
+    av_buffer_unref(&entry->metadata);
+    av_free(entry);
+    s->dovi_depth--;
+}
+
+static void mediacodec_dovi_queue_flush(MediaCodecH264DecContext *s)
+{
+    while (s->dovi_head)
+        mediacodec_dovi_queue_pop(s, NULL, s->dovi_head);
+}
+
+static int mediacodec_dovi_queue_packet(AVCodecContext *avctx,
+                                        MediaCodecH264DecContext *s,
+                                        const AVPacket *pkt)
+{
+    H2645Packet h2645_pkt = { 0 };
+    AVDOVIMetadata *metadata = NULL;
+    AVBufferRef *metadata_buf = NULL;
+    MediaCodecDOVIMetadata *entry = NULL;
+    const uint8_t *sd;
+    size_t sd_size;
+    int metadata_size;
+    int has_vcl = 0;
+    int rpu_parsed = 0;
+    int ret;
+
+    sd = av_packet_get_side_data(pkt, AV_PKT_DATA_DOVI_CONF, &sd_size);
+    if (sd && sd_size >= sizeof(s->dovi.cfg))
+        s->dovi.cfg = *(const AVDOVIDecoderConfigurationRecord *) sd;
+
+    ret = ff_h2645_packet_split(&h2645_pkt, pkt->data, pkt->size, avctx, 0,
+                                AV_CODEC_ID_HEVC, 0);
+    if (ret < 0) {
+        ret = 0;
+        goto out;
+    }
+
+    for (int i = h2645_pkt.nb_nals - 1; i >= 0; i--) {
+        const H2645NAL *nal = &h2645_pkt.nals[i];
+        if (nal->type < 32)
+            has_vcl = 1;
+        if (rpu_parsed || nal->type != HEVC_NAL_UNSPEC62 || nal->size <= 2 ||
+            nal->nuh_layer_id || nal->temporal_id)
+            continue;
+
+        ret = ff_dovi_rpu_parse(&s->dovi, nal->data + 2, nal->size - 2,
+                                avctx->err_recognition);
+        if (ret < 0) {
+            av_log(avctx, AV_LOG_WARNING,
+                   "Error parsing Dolby Vision RPU for MediaCodec output.\n");
+            ret = 0;
+            goto out;
+        }
+        rpu_parsed = 1;
+    }
+
+    if (!has_vcl) {
+        ret = 0;
+        goto out;
+    }
+
+    metadata_size = ff_dovi_get_metadata(&s->dovi, &metadata);
+    if (metadata_size <= 0) {
+        ret = metadata_size;
+        goto out;
+    }
+    metadata_buf = av_buffer_create((uint8_t *) metadata, metadata_size,
+                                    NULL, NULL, 0);
+    if (!metadata_buf) {
+        av_free(metadata);
+        ret = AVERROR(ENOMEM);
+        goto out;
+    }
+    metadata = NULL;
+
+    entry = av_mallocz(sizeof(*entry));
+    if (!entry) {
+        ret = AVERROR(ENOMEM);
+        goto out;
+    }
+    entry->presentation_time_us =
+        mediacodec_presentation_time_us(avctx, pkt->pts);
+    entry->metadata = metadata_buf;
+    metadata_buf = NULL;
+    if (s->dovi_tail)
+        s->dovi_tail->next = entry;
+    else
+        s->dovi_head = entry;
+    s->dovi_tail = entry;
+    s->dovi_depth++;
+
+    if (s->dovi_depth > 256) {
+        av_log(avctx, AV_LOG_WARNING,
+               "Dropping stale Dolby Vision metadata queued for MediaCodec.\n");
+        mediacodec_dovi_queue_pop(s, NULL, s->dovi_head);
+    }
+    ret = 0;
+
+out:
+    ff_h2645_packet_uninit(&h2645_pkt);
+    av_buffer_unref(&metadata_buf);
+    av_free(metadata);
+    return ret;
+}
+
+static int mediacodec_dovi_attach_frame(AVCodecContext *avctx,
+                                        MediaCodecH264DecContext *s,
+                                        AVFrame *frame)
+{
+    const int64_t presentation_time_us =
+        mediacodec_presentation_time_us(avctx, frame->pts);
+    MediaCodecDOVIMetadata *previous = NULL;
+    MediaCodecDOVIMetadata *entry = s->dovi_head;
+
+    while (entry) {
+        if (entry->presentation_time_us == presentation_time_us) {
+            AVBufferRef *metadata = av_buffer_ref(entry->metadata);
+            if (!metadata)
+                return AVERROR(ENOMEM);
+            if (!av_frame_new_side_data_from_buf(
+                    frame, AV_FRAME_DATA_DOVI_METADATA, metadata)) {
+                av_buffer_unref(&metadata);
+                return AVERROR(ENOMEM);
+            }
+            mediacodec_dovi_queue_pop(s, previous, entry);
+            return 0;
+        }
+        previous = entry;
+        entry = entry->next;
+    }
+    return 0;
+}
+#endif
 
