+ */
+
+#ifndef AVCODEC_OHCODEC_SURFACE_H
+#define AVCODEC_OHCODEC_SURFACE_H
+
+#include <stdint.h>
+
+/**
+ * Opaque OHCodec surface output stored in AVFrame.data[3] when the frame's
+ * format is AV_PIX_FMT_OHCODEC.
+ */
+typedef struct AVOHCodecBuffer AVOHCodecBuffer;
+
+/**
+ * Release an OHCodec output buffer exactly once.
+ *
+ * @param buffer the surface output from AVFrame.data[3]
+ * @param render nonzero to render to the configured surface, zero to drop
+ * @return 0 on success, a negative AVERROR value on failure
+ */
+int av_ohcodec_release_buffer(AVOHCodecBuffer *buffer, int render);
+
+/**
+ * Release an OHCodec output buffer exactly once and schedule it on the
+ * configured surface at a CLOCK_MONOTONIC timestamp.
+ *
+ * The timestamp must be reasonably close to the current monotonic time. A
+ * timestamp far in the future can retain the codec output and delay later
+ * buffers. This maps to OH_VideoDecoder_RenderOutputBufferAtTime().
+
+ * @param buffer the surface output from AVFrame.data[3]
+ * @param time timestamp in nanoseconds on CLOCK_MONOTONIC
+ * @return 0 on success, a negative AVERROR value on failure
+ */
+int av_ohcodec_render_buffer_at_time(AVOHCodecBuffer *buffer, int64_t time);
+
+#endif /* AVCODEC_OHCODEC_SURFACE_H */
