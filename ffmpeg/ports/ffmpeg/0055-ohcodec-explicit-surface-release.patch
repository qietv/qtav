                     (OFFSET(input_mutex), OFFSET(output_mutex)),
                     (OFFSET(input_cond), OFFSET(output_cond)));
 
-typedef struct OHCodecBuffer {
+struct AVOHCodecBuffer {
     uint32_t index;
     OH_AVBuffer *buffer;
     OH_AVCodec **dec_ref;  ///< RefStruct reference
-} OHCodecBuffer;
+    atomic_int released;
+};
+
+int av_ohcodec_release_buffer(AVOHCodecBuffer *buffer, int render)
+{
+    if (!buffer)
+        return AVERROR(EINVAL);
+
+    if (atomic_exchange(&buffer->released, 1))
+        return 0;
+
+    OH_AVCodec *dec = *buffer->dec_ref;
+    OH_AVErrCode err = render
+        ? OH_VideoDecoder_RenderOutputBuffer(dec, buffer->index)
+        : OH_VideoDecoder_FreeOutputBuffer(dec, buffer->index);
+    return ff_oh_err_to_ff_err(err);
+}
+
+int av_ohcodec_render_buffer_at_time(AVOHCodecBuffer *buffer, int64_t time)
+{
+    if (!buffer || time <= 0)
+        return AVERROR(EINVAL);
+
+    if (atomic_exchange(&buffer->released, 1))
+        return 0;
+
+    OH_AVCodec *dec = *buffer->dec_ref;
+    return ff_oh_err_to_ff_err(
+        OH_VideoDecoder_RenderOutputBufferAtTime(
+            dec,
+            buffer->index,
+            time));
+}
 
