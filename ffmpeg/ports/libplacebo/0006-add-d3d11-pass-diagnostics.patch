+static uint64_t diagnostic_now(void)
+{
+    LARGE_INTEGER counter, frequency;
+    QueryPerformanceCounter(&counter);
+    QueryPerformanceFrequency(&frequency);
+    return (uint64_t) counter.QuadPart * 1000000llu /
+           (uint64_t) frequency.QuadPart;
+}
+
+uint64_t pl_d3d11_diagnostic_start(pl_gpu gpu)
+{
+    struct pl_gpu_d3d11 *p = PL_PRIV(gpu);
+    return p->qtav_diagnostics_enabled ? diagnostic_now() : 0;
+}
+
+void pl_d3d11_diagnostic_end(pl_gpu gpu, const char *stage, uint64_t started)
+{
+    struct pl_gpu_d3d11 *p = PL_PRIV(gpu);
+    if (!started || !p->qtav_diagnostics_enabled)
+        return;
+
+    uint64_t finished = diagnostic_now();
+    uint64_t elapsed = finished - started;
+    if (elapsed < 500)
+        return;
+
+    char line[256];
+    int length = snprintf(line, sizeof(line),
+        "%llu pid=%lu tid=%lu stage=%s us=%llu\r\n",
+        (unsigned long long) finished,
+        (unsigned long) GetCurrentProcessId(),
+        (unsigned long) GetCurrentThreadId(), stage,
+        (unsigned long long) elapsed);
+    if (length <= 0)
+        return;
+
+    HANDLE file = CreateFileA(p->qtav_diagnostics_path, FILE_APPEND_DATA,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+        OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return;
+
+    DWORD written;
+    WriteFile(file, line, (DWORD) PL_MIN(length, (int) sizeof(line)),
+              &written, NULL);
+    CloseHandle(file);
+}
+
+bool pl_d3d11_timers_disabled(pl_gpu gpu)
+{
+    struct pl_gpu_d3d11 *p = PL_PRIV(gpu);
+    return p->qtav_disable_timers;
+}
