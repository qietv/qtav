diff --git a/src/d3d11/meson.build b/src/d3d11/meson.build
--- a/src/d3d11/meson.build
+++ b/src/d3d11/meson.build
@@ -3,8 +3,13 @@ d3d11_header = cc.check_header('d3d11.h', required: false) # needed publicly
 d3d11_headers_extra = [ # needed internally
   cc.check_header('d3d11_4.h', required: d3d11),
   cc.check_header('dxgi1_6.h', required: d3d11),
 ]
+version_dep = cc.find_library('version', required: false)
+if ['msvc', 'clang-cl'].contains(cc.get_id())
+  # link.exe and lld-link resolve Windows SDK import libraries through LIB.
+  version_dep = declare_dependency(link_args: 'version.lib')
+endif
 d3d11_deps = [
-  dependency('spirv-cross-c-shared', version: '>=0.29.0', required: d3d11),
-  cc.find_library('version', required: d3d11),
+  dependency('spirv-cross-c', version: '>=0.29.0', required: d3d11),
+  version_dep,
 ]
